  m_Script: {fileID: 11500000, guid: eff8cf1150430464bb8ab0f6f09a89e4, type: 3}
  m_Name: Scene_Kitchen
  m_EditorClassIdentifier: 
  sceneTitle: "Home \u2014 Tuesday, 4:47 PM"
  background: {fileID: 0}
  placeholderColor: {r: 0.9, g: 0.85, b: 0.7, a: 1}
  bananaRotStage: 5
  npcSprite: {fileID: -5377789987342297270, guid: 408ee9cb6e5621d4aa4d7d0a8a83a18d, type: 3}
  npcName: The Owner
  npcPlaceholderColor: {r: 0.95, g: 0.8, b: 0.65, a: 1}
  backgroundMusic: {fileID: 8300000, guid: ad72923d4d1d9e64691ea86119cbc26b, type: 3}
  lines:
  - speaker: Narrator
    text: The time machine fizzles. The dashboard goes dark. You are home.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: I'm... I'm back. I made it.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: I have seen the dawn of mammals. I have witnessed the rise of empires.
      I have refused a crown.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: And now... I am very, very tired.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Narrator
    text: A hand reaches down.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: The Owner
    text: Oh, gross. This banana is completely brown.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: "Wait. WAIT. I have so much to tell you\u2014"
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: The Owner
    text: Eh. Banana bread it is.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: ...
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: You know what? That's fine. That's actually fine.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  choices:
  - label: Accept your fate.
    nextScene: {fileID: 0}
    startAtLineIndex: 0
    endsGame: 1
    endingText: You become the finest loaf of banana bread the kitchen has ever produced.
      The owner posts a photo. It gets 47 likes. You would have wanted it this way.
      THE END.
    endingId: kitchen_bread
    endingTitle: Banana Bread
