%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eff8cf1150430464bb8ab0f6f09a89e4, type: 3}
  m_Name: Scene_Warzone
  m_EditorClassIdentifier: 
  sceneTitle: "The Banana Wars \u2014 Year 3024"
  background: {fileID: 0}
  placeholderColor: {r: 0.3, g: 0.3, b: 0.35, a: 1}
  bananaRotStage: 4
  npcSprite: {fileID: -3680981928472756049, guid: 2ab9ec0a606054942ab7116f8df1b447, type: 3}
  npcName: Apple General
  npcPlaceholderColor: {r: 0.7, g: 0.1, b: 0.15, a: 1}
  backgroundMusic: {fileID: 8300000, guid: adcbf86e61734fc4f89ac9f9b8baf043, type: 3}
  lines:
  - speaker: Narrator
    text: Sirens. Smoke. The skyline is on fire. A faction of bananas is locked in
      battle with a faction of apples.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 8300000, guid: 6d8b71d9d6f280b4eba0376be23a3926, type: 3}
  - speaker: Banana
    text: Oh come on.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Apple General
    text: "A new banana! Tell us, traveler \u2014 whose side are you on?"
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: I literally just got here.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Apple General
    text: The bananas have prophesied a chosen one. Brown of skin. Wise of seed.
      They believe it is you.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: I'm not a chosen one. I'm a snack that someone left on a dashboard.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Apple General
    text: The prophecy is very specific.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  - speaker: Banana
    text: I am increasingly aware of my own mortality and would like to leave now.
    speakerSprite: {fileID: 0}
    rotStageOverride: 0
    sfx: {fileID: 0}
  choices:
  - label: Lead the banana revolution. Glory awaits.
    nextScene: {fileID: 0}
    startAtLineIndex: 0
    endsGame: 1
    endingText: You become the Banana Messiah. You unite the fruit. You are loved.
      You are also extremely brown by this point. You die a hero, three days later,
      of natural causes. Statues are erected. THE END.
    endingId: war_messiah
    endingTitle: The Banana Messiah
  - label: Defect to the apples. Snitch on the bananas.
    nextScene: {fileID: 0}
    startAtLineIndex: 0
    endsGame: 1
    endingText: Your betrayal becomes the central tragedy of the Fruit Wars. They
      write operas about you. None of them are flattering. THE END.
    endingId: war_traitor
    endingTitle: The Operatic Tragedy
  - label: Sneak back to the time machine. This isn't your fight.
    nextScene: {fileID: 11400000, guid: faa8e3fd09e3dea4ab7b942722c35c92, type: 2}
    startAtLineIndex: 0
    endsGame: 0
    endingText: 
    endingId: 
    endingTitle: 
